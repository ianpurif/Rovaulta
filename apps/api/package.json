{
  "name": "@rovaulta/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "evidence:p52-agent": "bun scripts/p52-agent-evidence.ts",
    "evidence:p52-agent:live-read": "bun run --env-file ../../.env scripts/p52-agent-live-read-evidence.ts",
    "evidence:p11-graph": "bun run --env-file ../../.env scripts/p11-graph-live-evidence.ts",
    "evidence:cre-simulation": "bun scripts/cre-simulation-evidence.ts",
    "p13:setup-template": "bun scripts/p13-setup-template.ts",
    "p13:account-evaluation": "bun run --env-file ../../.env scripts/p13-account-evaluation.ts",
    "p13:provision-site-secret": "bun run --env-file ../../.env scripts/p13-provision-site-secret.ts",
    "record:sepolia-clearance": "bun run --env-file ../../.env scripts/record-sepolia-clearance.ts",
    "clearance:digest": "bun scripts/get-clearance-digest.ts",
    "evidence:p5-presign": "bun run --env-file ../../.env scripts/p5-presign-evidence.ts",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "bun test"
  },
  "dependencies": {
    "@google/genai": "2.21.0",
    "@rovaulta/chain-client": "workspace:*",
    "@rovaulta/chainlink-cre": "workspace:*",
    "@rovaulta/domain": "workspace:*",
    "@rovaulta/simulation-core": "workspace:*",
    "fastify": "5.12.1",
    "viem": "2.56.3"
  },
  "devDependencies": {
    "typescript": "5.9.2",
    "@types/bun": "1.4.0"
  }
}
